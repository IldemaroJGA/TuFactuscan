<?xml version="1.0" encoding="UTF-8"?>
<!--
  TuFactuScan - Backend (API REST + panel web)
  Fichero de construcción de Maven: define la versión de Spring Boot,
  la versión de Java y las librerías (dependencias) que usa el proyecto.
  Las dependencias se añaden por bloques a medida que avanza la fase 2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre de Spring Boot: fija versiones compatibles de todas las librerías -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.tufactuscan</groupId>
    <artifactId>tufactuscan-backend</artifactId>
    <version>0.1.0</version>
    <name>TuFactuScan Backend</name>
    <description>API REST y panel web de TuFactuScan (Proyecto Final DAM)</description>

    <properties>
        <!-- Compilamos para Java 21 (LTS). Funciona igual con JDK 21 a 26 instalado. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- ===== Bloque 1: web + base de datos ===== -->

        <!-- Spring MVC + servidor Tomcat integrado: permite crear controladores REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: mapea las tablas MySQL a clases Java -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validación de datos de entrada con anotaciones (@NotBlank, @Email...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL (solo se necesita al ejecutar) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Bloque 2: seguridad ===== -->

        <!-- Spring Security: filtros de autenticación, roles y cifrado BCrypt -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Soporte de tokens JWT (crear y validar tokens firmados) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ===== Pruebas ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empaqueta la aplicación en un .jar ejecutable (java -jar ...) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
